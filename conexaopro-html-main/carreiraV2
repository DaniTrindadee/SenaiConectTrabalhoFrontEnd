<script>

    // Verifica se encontrou uma trilha
    
    if (!trilha) {
    
        document.getElementById("tituloTrilha").innerHTML =
        "🛤️ Sua Trilha";
    
        document.getElementById("descricaoTrilha").textContent =
        "Selecione um curso para visualizar sua trilha de carreira.";
    
    }
    
    
    // Atualiza automaticamente quando o curso mudar
    // (caso o aluno troque o curso sem sair da página)
    
    window.addEventListener("storage", function(event){
    
    
        if(event.key === "cursoUsuario"){
    
            location.reload();
    
        }
    
    
    });
    
    
    // Função para trocar o curso manualmente,
    // caso queira usar em uma tela de seleção
    
    function selecionarCurso(novoCurso){
    
    
        localStorage.setItem(
            "cursoUsuario",
            novoCurso
        );
    
    
        location.reload();
    
    
    }
    
    
    
    // Função para sair da conta
    
    function sairConta(){
    
    
        localStorage.removeItem("nomeUsuario");
    
        localStorage.removeItem("cursoUsuario");
    
    
        window.location.href = "login.html";
    
    
    }
    
    
    
    </script>
    
    
